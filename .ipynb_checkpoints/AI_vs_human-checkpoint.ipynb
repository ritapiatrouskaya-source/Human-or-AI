    "# Complexity measures: lexical diversity\n",
    "def lexical_diversity(text):\n",
    "    tokens = text.split()\n",
    "    if len(tokens) == 0:\n",
    "        return 0\n",
    "    return len(set(tokens)) / len(tokens)\n",
    "\n",
    "\n",
    "df['lex_div'] = df['text_trunc'].apply(lexical_diversity)\n",
    "print(df.head())"
