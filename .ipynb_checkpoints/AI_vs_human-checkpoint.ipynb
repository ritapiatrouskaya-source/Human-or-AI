       "                                                                                                  ngram_range=(1,\n",
       "                                                                                                               2),\n",
       "                                                                                                  stop_words='english')),\n",
       "                                                                                 ('tfidf',\n",
       "                                                                                  TfidfVectorizer(max_features=5000,\n",
       "                                                                                                  min_df=5,\n",
       "                                                                                                  ngram_range=(1,\n",
       "                                                                                                               2))),\n",
       "                                                                                 ('w2v',\n",
